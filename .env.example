# Copy to .env.local (never committed) and adjust.

# Base URL of the Véritas API, without a trailing slash. Requests to /api/*
# on this site are proxied there (see next.config.ts).
# Local backend: dotnet run --project LuxuryStore-Backend --launch-profile http
API_URL=http://localhost:5152

# Optional. How long a page waits for the API, in milliseconds (default
# 10000). Raise it if the API sleeps when idle and wakes up slowly.
# VERITAS_API_TIMEOUT_MS=10000
