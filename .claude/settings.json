{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npm audit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test *)",
      "PowerShell(npm ls *)",
      "PowerShell(npm audit *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "PowerShell(npm install *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git merge *)",
      "PowerShell(git reset *)"
    ],
    "deny": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
